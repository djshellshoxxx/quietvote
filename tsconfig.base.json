{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"], "types": ["node"],
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true, "noFallthroughCasesInSwitch": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "erasableSyntaxOnly": true, "allowImportingTsExtensions": true, "noEmit": true,
    "verbatimModuleSyntax": true, "skipLibCheck": true, "isolatedModules": true
  }
}
