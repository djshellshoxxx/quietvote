@@ -0,0 +1,328 @@
+// Independent plaintext oracle for the randomized-election harness (test/random-elections.test.ts).
+//
+// It answers, from the PLAINTEXT plan of an election alone (who submitted what, in which log order, under which rules):
+// which ballot of which voter is counted, what every option's count is, what the published results must be, whether the
+// privacy floor allows a tally at all, and how the verifier must classify every envelope.
+//
+// Independence rule: this file imports nothing from packages/protocol/src or @quietvote/crypto. It is written from the
+// specs (QV-16 §5.13.2, §5.14.2-§5.14.4, §5.19.3, QV-ADR-021, QV-20 §5-§7) and from the errata recorded in
+// packages/protocol/NOTES.md (X-10, X-13, X-14, X-15). A ballot is identified by a small integer chosen by the generator,
+// never by a hash, so no protocol code is needed to decide the revote chain. SHA-256 (node:crypto) is used only for the
+// RFC 9162 root over the counted set.
+import { createHash } from 'node:crypto';
+
+export type Method = 'yes-no' | 'single-choice' | 'approval' | 'k-of-n';
+export interface OContest {
+  id: string;
+  method: Method;
+  options: readonly { id: string }[];
+  selection_limit?: number;
+  winners?: number;
+  rule?: { num: number; den: number; basis: 'yes+no' | 'counted'; strict: boolean };
+  tie_break: { type: string; option?: string };
+}
+export interface OQuorum {
+  type: 'fraction' | 'count';
+  num?: number;
+  den?: number;
+  value?: number;
+}
+export interface ORules {
+  contests: readonly OContest[];
+  rollSize: number;
+  maxPerVoter: number;
+  maxSpoilsPerVoter: number;
+  quorum?: OQuorum | undefined;
+  minCountedBallots?: number | undefined;
+}
+
+/** A way in which an envelope is broken regardless of where it sits in the log (QV-16 §5.14.4 checks 1-9). */
+export type Defect = 'schema' | 'ctx' | 'sig' | 'proof';
+export type Selections = Record<string, string[]>;
+
+/** One distinct ballot body. The same body can appear in several log events (replay, spoil-then-cast). */
+export interface OBallot {
+  id: number;
+  /** Actor label. Roll members are `v<index>`; anything else is a key that is not on the roll. */
+  voter: string;
+  eligible: boolean;
+  /** The ballot this one names as its predecessor: an earlier ballot id, null (32 zero bytes) or random bytes. */
+  supersedes: number | null | 'garbage';
+  selections: Selections;
+  defects: readonly Defect[];
+}
+export type Slot = 'early' | 'window' | 'late';
+/** One voter envelope in log order. `early` = before election-open, `late` = after election-close. */
+export interface OEvent {
+  slot: Slot;
+  intent: 'cast' | 'spoil';
+  ballot: number;
+}
+
+export type Fate =
+  | { kind: 'counted' }
+  /** Admissible when it was appended, later replaced by the same voter's next admissible ballot. */
+  | { kind: 'superseded' }
+  /** Admitted Benaloh audit record (first one for this ballot). */
+  | { kind: 'audit' }
+  /** A further admitted spoil of an already audited ballot: absorbed without a finding. */
+  | { kind: 'audit-repeat' }
+  | { kind: 'ignored'; code: string };
+
+export interface Classification {
+  fates: Fate[];
+  /** voter label -> { counted ballot id, index of the counted event }. */
+  counted: Map<string, { ballot: number; event: number }>;
+  /** Admitted audit ballot ids, in log order. */
+  audits: number[];
+  /** Ballot ids that some authenticated spoil names: they can never be counted. */
+  spoiled: Set<number>;
+}
+
+const ignored = (code: string): Fate => ({ kind: 'ignored', code });
+
+/** First failing context-free check in the order of QV-16 §5.14.4 (1 schema, 2 ctx, 3 eligibility, 4 signature, 8 proofs). */
+export function envelopeError(b: OBallot): string | null {
+  if (b.defects.includes('schema')) return 'E_SCHEMA';
+  if (b.defects.includes('ctx')) return 'E_CTX';
+  if (!b.eligible) return 'E_VOTER_NOT_ELIGIBLE';
+  if (b.defects.includes('sig')) return 'E_SIG';
+  if (b.defects.includes('proof')) return 'E_CDS';
+  return null;
+}
+
+/**
+ * The counting rule (QV-16 §5.14.2): per voter, in log order, a cast is admissible iff its envelope is valid, it lies in the
+ * window, it names the voter's previous admissible ballot (or zero bytes when there is none), the voter has fewer than
+ * `max_per_voter` admissible ballots so far, and its code was never spoiled. The counted ballot is the last admissible one.
+ */
+export function classify(rules: ORules, ballots: readonly OBallot[], events: readonly OEvent[]): Classification {
+  const body = (e: OEvent): OBallot => {
+    const b = ballots[e.ballot];
+    if (b === undefined || b.id !== e.ballot) throw new Error(`oracle: event names unknown ballot ${e.ballot}`);
+    return b;
+  };
+  // QV-16 §5.13.2 item 4 with NOTES X-10 / B1-01: every authenticated spoil puts its code in the spoiled set, wherever the
+  // record sits (outside the window, above the audit limit) and whether the same body is cast before or after it.
+  const spoiled = new Set<number>();
+  for (const e of events) if (e.intent === 'spoil' && envelopeError(body(e)) === null) spoiled.add(e.ballot);
+
+  const fates: Fate[] = [];
+  const audits: number[] = [];
+  const audited = new Set<number>();
+  const voters = new Map<string, { last: number | null; lastEvent: number; admissible: number; spoils: number }>();
+  events.forEach((e, i) => {
+    const b = body(e);
+    const err = envelopeError(b);
+    if (err !== null) {
+      fates[i] = ignored(err);
+      return;
+    }
+    if (e.slot !== 'window') {
+      fates[i] = ignored('E_TIME_WINDOW');
+      return;
+    }
+    let st = voters.get(b.voter);
+    if (st === undefined) voters.set(b.voter, (st = { last: null, lastEvent: -1, admissible: 0, spoils: 0 }));
+    if (e.intent === 'spoil') {
+      st.spoils += 1;
+      if (st.spoils > rules.maxSpoilsPerVoter) fates[i] = ignored('E_REVOTE_LIMIT');
+      else if (audited.has(b.id)) fates[i] = { kind: 'audit-repeat' };
+      else {
+        audited.add(b.id);
+        audits.push(b.id);
+        fates[i] = { kind: 'audit' };
+      }
+      return;
+    }
+    if (b.supersedes !== st.last) fates[i] = ignored('E_SUPERSEDES');
+    else if (st.admissible >= rules.maxPerVoter) fates[i] = ignored('E_REVOTE_LIMIT');
+    else if (spoiled.has(b.id)) fates[i] = ignored('E_SPOILED_CODE_CAST');
+    else {
+      if (st.lastEvent >= 0) fates[st.lastEvent] = { kind: 'superseded' };
+      st.last = b.id;
+      st.lastEvent = i;
+      st.admissible += 1;
+      fates[i] = { kind: 'counted' };
+    }
+  });
+  const counted = new Map<string, { ballot: number; event: number }>();
+  for (const [voter, st] of voters) if (st.last !== null) counted.set(voter, { ballot: st.last, event: st.lastEvent });
+  return { fates, counted, audits, spoiled };
+}
+
+export type Counts = Record<string, Record<string, number>>;
+
+/** Per option: the number of counted ballots that select it. */
+export function tallyCounts(contests: readonly OContest[], ballots: readonly OBallot[], counted: Iterable<{ ballot: number }>): Counts {
+  const counts: Counts = {};
+  for (const c of contests) {
+    counts[c.id] = {};
+    for (const o of c.options) counts[c.id]![o.id] = 0;
+  }
+  for (const { ballot } of counted) {
+    const sel = ballots[ballot]!.selections;
+    for (const c of contests) for (const oid of new Set(sel[c.id] ?? [])) counts[c.id]![oid]! += 1;
+  }
+  return counts;
+}
+
+export type Outcome = { kind: 'passed' | 'rejected' | 'no-quorum' | 'tie' | 'winners'; winners?: string[]; tied?: string[]; reason?: string };
+export interface ResultRow {
+  contest: string;
+  participation: number;
+  quorum_met: boolean;
+  outcome: Outcome;
+}
+
+/** QV-16 §5.19.3 item 1. Compared by cross-multiplication in exact integers; no division. */
+export function quorumIsMet(q: OQuorum | undefined, V: number, rollSize: number): boolean {
+  if (q === undefined) return true;
+  if (q.type === 'count') return V >= q.value!;
+  return BigInt(V) * BigInt(q.den!) >= BigInt(q.num!) * BigInt(rollSize);
+}
+
+const byId = (a: string, b: string): number => (a < b ? -1 : a > b ? 1 : 0);
+
+/** QV-16 §5.19.3 items 2-3 with the outcome format of NOTES X-15. `T` is the per-option count of ONE contest. */
+export function contestOutcome(c: OContest, T: Record<string, number>, V: number): Outcome {
+  if (c.method === 'yes-no') {
+    const r = c.rule!;
+    const yes = BigInt(T['yes'] ?? 0);
+    const no = BigInt(T['no'] ?? 0);
+    const base = r.basis === 'yes+no' ? yes + no : BigInt(V);
+    if (base === 0n) return { kind: 'rejected', reason: 'no-base' };
+    const lhs = yes * BigInt(r.den);
+    const rhs = BigInt(r.num) * base;
+    if (lhs > rhs) return { kind: 'passed' };
+    if (lhs < rhs) return { kind: 'rejected' };
+    if (!r.strict) return { kind: 'passed' }; // exactly at a ">=" threshold
+    // exactly at a strict threshold: the rule cannot decide, the declared tie-break does
+    if (c.tie_break.type === 'declare-tie') return { kind: 'tie', tied: ['no', 'yes'] };
+    const winner = c.tie_break.type === 'status-quo' ? c.tie_break.option! : 'no'; // lexicographic: "no" < "yes"
+    return { kind: winner === 'yes' ? 'passed' : 'rejected', reason: 'tie-break' };
+  }
+  let seats = c.winners ?? (c.method === 'k-of-n' ? c.selection_limit! : 1);
+  // Walk the distinct counts from the highest; a whole level is seated while it fits.
+  const levels = [...new Set(c.options.map((o) => T[o.id] ?? 0))].sort((a, b) => b - a);
+  const winners: string[] = [];
+  for (const level of levels) {
+    const ids = c.options.map((o) => o.id).filter((id) => (T[id] ?? 0) === level).sort(byId);
+    if (ids.length <= seats) {
+      winners.push(...ids);
+      seats -= ids.length;
+      continue;
+    }
+    if (seats === 0) break;
+    if (c.tie_break.type === 'declare-tie') return { kind: 'tie', winners, tied: ids };
+    return { kind: 'winners', winners: [...winners, ...ids.slice(0, seats)], reason: 'tie-break' };
+  }
+  return { kind: 'winners', winners };
+}
+
+export function evaluateResults(rules: ORules, counts: Counts, V: number): ResultRow[] {
+  const quorum_met = quorumIsMet(rules.quorum, V, rules.rollSize);
+  return rules.contests.map((c) => ({
+    contest: c.id,
+    participation: V,
+    quorum_met,
+    outcome: quorum_met ? contestOutcome(c, counts[c.id] ?? {}, V) : { kind: 'no-quorum' },
+  }));
+}
+
+/** QV-ADR-021 (NOTES X-13): the manifest value, else 5 for a roll of 8 or more, else 3. */
+export function privacyFloor(rules: ORules): number {
+  return rules.minCountedBallots ?? (rules.rollSize >= 8 ? 5 : 3);
+}
+
+export interface Expectation extends Classification {
+  V: number;
+  counts: Counts;
+  results: ResultRow[];
+  floor: number;
+  belowFloor: boolean;
+  castSeen: number;
+  spoilSeen: number;
+  /** Number of admissible ballots that a later ballot of the same voter replaced. */
+  superseded: number;
+  /** Findings the verifier must report for ignored envelopes, by code. */
+  ignored: Record<string, number>;
+  /** Named checks of the ballot section: true = `pass`. */
+  checks: { ballotsValid: boolean; ballotsLatest: boolean; window: boolean; benaloh: boolean; encoding: boolean };
+}
+
+/** Everything the harness compares against the real pipeline, from the plaintext plan alone. */
+export function expectElection(rules: ORules, ballots: readonly OBallot[], events: readonly OEvent[]): Expectation {
+  const cl = classify(rules, ballots, events);
+  const V = cl.counted.size;
+  const counts = tallyCounts(rules.contests, ballots, cl.counted.values());
+  const ignoredBy: Record<string, number> = {};
+  const checks = { ballotsValid: true, ballotsLatest: true, window: true, benaloh: true, encoding: true };
+  let superseded = 0;
+  cl.fates.forEach((f, i) => {
+    if (f.kind === 'superseded') superseded += 1;
+    if (f.kind !== 'ignored') return;
+    ignoredBy[f.code] = (ignoredBy[f.code] ?? 0) + 1;
+    const e = events[i]!;
+    switch (f.code) {
+      case 'E_TIME_WINDOW':
+        checks.window = false;
+        break;
+      case 'E_SUPERSEDES':
+        checks.ballotsLatest = false;
+        break;
+      case 'E_REVOTE_LIMIT':
+        if (e.intent === 'cast') checks.ballotsLatest = false; // an over-limit audit is ignored without failing a check
+        break;
+      case 'E_SPOILED_CODE_CAST':
+        checks.benaloh = false;
+        break;
+      case 'E_SCHEMA':
+        checks.encoding = false;
+        checks.ballotsValid = false;
+        break;
+      default:
+        checks.ballotsValid = false; // E_CTX, E_VOTER_NOT_ELIGIBLE, E_SIG, E_CDS
+    }
+  });
+  const floor = privacyFloor(rules);
+  return {
+    ...cl,
+    V,
+    counts,
+    results: evaluateResults(rules, counts, V),
+    floor,
+    belowFloor: V < floor,
+    castSeen: events.filter((e) => e.intent === 'cast').length,
+    spoilSeen: events.filter((e) => e.intent === 'spoil').length,
+    superseded,
+    ignored: ignoredBy,
+    checks,
+  };
+}
+
+// ---------------------------------------------------------------- RFC 9162 root over the counted set
+
+const sha256 = (...parts: Uint8Array[]): Buffer => {
+  const h = createHash('sha256');
+  for (const p of parts) h.update(p);
+  return h.digest();
+};
+
+/**
+ * QV-16 §5.19.1 `counted_root`: RFC 9162 Merkle tree hash over leaf_data = ballot_code(32) || voter_pk(32), sorted by voter_pk.
+ * Bottom-up formulation (pair neighbours, promote an unpaired last node unchanged), which equals the RFC's recursive
+ * split at the largest power of two below n.
+ */
+export function countedRootHex(pairs: readonly { voter: string; code: string }[]): string {
+  const sorted = [...pairs].sort((a, b) => byId(a.voter, b.voter));
+  let level: Buffer[] = sorted.map((p) => sha256(Uint8Array.of(0), Buffer.from(p.code + p.voter, 'hex')));
+  if (level.length === 0) return sha256().toString('hex');
+  while (level.length > 1) {
+    const next: Buffer[] = [];
+    for (let i = 0; i + 1 < level.length; i += 2) next.push(sha256(Uint8Array.of(1), level[i]!, level[i + 1]!));
+    if (level.length % 2 === 1) next.push(level[level.length - 1]!);
+    level = next;
+  }
+  return level[0]!.toString('hex');
+}
