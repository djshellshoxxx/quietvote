@@ -0,0 +1,155 @@
+// World variant for the privacy canary tests (T-245): every request of the election flow is sent with node:http so that the
+// test controls the source address the server sees (a loopback alias per actor, where the platform can bind one) and every
+// request header, and every exchange is recorded for scanning. The protocol flow itself is the unchanged `World`.
+import { request as httpRequest } from 'node:http';
+import { connect } from 'node:net';
+import { utf8, type Ed25519Keypair } from '@quietvote/crypto';
+import type { Manifest, ManifestContest } from '@quietvote/protocol';
+import { signRequest } from '../../src/index.ts';
+import { World, type Resp, type WorldOpts } from './world.ts';
+
+/** What one actor's client looks like on the network. */
+export interface NetIdentity {
+  name: string;
+  /** Loopback alias the client binds to, so `socket.remoteAddress` on the server is this value. */
+  localAddress?: string;
+  /** Sent on every request of this actor. */
+  headers: Record<string, string>;
+  /** Sent as `Authorization: Bearer ...` on requests that carry no request signature. */
+  bearer?: string;
+  /** Appended to every request target as `ref=<token>`. */
+  queryToken?: string;
+}
+
+export interface Exchange {
+  n: number;
+  actor: string;
+  /** What the step was for (`register`, `cast`, `error-probe`, ...). */
+  label: string;
+  method: string;
+  target: string;
+  /** Value of the request's Authorization header, if any. */
+  authorization: string | undefined;
+  status: number;
+  /** Status line and response header block as received. */
+  head: string;
+  body: Buffer;
+  /** Canary classes this response may legitimately carry (decided by the caller of the step). */
+  allow: ReadonlySet<string>;
+}
+
+interface Scope {
+  id: NetIdentity;
+  label: string;
+  allow: ReadonlySet<string>;
+}
+
+export interface ManifestText {
+  title: string;
+  contests: ManifestContest[];
+  trusteeNames: string[];
+}
+
+const NONE: ReadonlySet<string> = new Set();
+/** Routes that refuse unknown query parameters: the query canary is left off there. */
+const STRICT_QUERY = /\/(spoil-shares|imports|admin\/elections)(\?|$)/;
+
+export class CanaryWorld extends World {
+  readonly exchanges: Exchange[] = [];
+  /** False when this platform cannot bind the loopback aliases; the source-address canaries are then not injectable. */
+  peerBinding = false;
+  manifestText: ManifestText | undefined;
+  private scope: Scope;
+
+  constructor(o: WorldOpts, base: NetIdentity) {
+    super(o);
+    this.scope = { id: base, label: 'setup', allow: NONE };
+  }
+
+  override async start(): Promise<void> {
+    await super.start();
+    const u = new URL(this.base);
+    const probe = this.scope.id.localAddress;
+    this.peerBinding = probe === undefined ? false : await new Promise<boolean>((resolve) => {
+      const s = connect({ host: u.hostname, port: Number(u.port), localAddress: probe });
+      s.once('connect', () => {
+        s.destroy();
+        resolve(true);
+      });
+      s.once('error', () => resolve(false));
+    });
+  }
+
+  /** Runs `fn` as `id`: all requests made inside carry that identity and are recorded under `label` with the given allowance. */
+  async as<T>(id: NetIdentity, label: string, fn: () => Promise<T>, allow: readonly string[] = []): Promise<T> {
+    const prev = this.scope;
+    this.scope = { id, label, allow: new Set(allow) };
+    try {
+      return await fn();
+    } finally {
+      this.scope = prev;
+    }
+  }
+
+  /** The most recent exchange (e.g. to read a binary response body). */
+  get lastExchange(): Exchange {
+    const e = this.exchanges.at(-1);
+    if (!e) throw new Error('no exchange recorded yet');
+    return e;
+  }
+
+  override async req(
+    method: string, path: string, body?: unknown,
+    o: { key?: Ed25519Keypair; headers?: Record<string, string>; raw?: Uint8Array; nonce?: Uint8Array; ts?: number } = {},
+  ): Promise<Resp> {
+    const { id, label, allow } = this.scope;
+    const target = id.queryToken !== undefined && !STRICT_QUERY.test(path) ? `${path}${path.includes('?') ? '&' : '?'}ref=${id.queryToken}` : path;
+    const bytes = o.raw ?? (body === undefined ? new Uint8Array(0) : utf8(JSON.stringify(body)));
+    const headers: Record<string, string> = { ...id.headers, ...(o.headers ?? {}) };
+    if (bytes.length > 0) headers['content-type'] = 'application/json';
+    let authorization: string | undefined;
+    // the signature covers the final request target, query canary included
+    if (o.key) authorization = signRequest(o.key.secretKey, o.key.publicKey, method, target, this.audience, bytes, o.ts ?? this.nowSec, o.nonce ?? this.rng.bytes(16));
+    else if (id.bearer !== undefined) authorization = `Bearer ${id.bearer}`;
+    if (authorization !== undefined) headers['authorization'] = authorization;
+    const r = await this.send(id, method, target, headers, bytes);
+    const head = `HTTP/1.1 ${r.status}\r\n${r.rawHeaders.map((v, i) => (i % 2 === 0 ? `${v}: ` : `${v}\r\n`)).join('')}`;
+    this.exchanges.push({ n: this.exchanges.length, actor: id.name, label, method, target, authorization, status: r.status, head, body: r.body, allow });
+    const h = new Headers();
+    for (let i = 0; i + 1 < r.rawHeaders.length; i += 2) h.append(r.rawHeaders[i]!, r.rawHeaders[i + 1]!);
+    const text = r.body.toString('utf8');
+    let json: unknown;
+    try {
+      json = JSON.parse(text);
+    } catch {
+      json = undefined;
+    }
+    return { status: r.status, headers: h, json, text };
+  }
+
+  private send(id: NetIdentity, method: string, target: string, headers: Record<string, string>, bytes: Uint8Array): Promise<{ status: number; rawHeaders: string[]; body: Buffer }> {
+    const u = new URL(this.base);
+    return new Promise((resolve, reject) => {
+      const req = httpRequest({
+        host: u.hostname, port: Number(u.port), method, path: target, agent: false,
+        headers: { ...headers, connection: 'close', ...(bytes.length > 0 ? { 'content-length': String(bytes.length) } : {}) },
+        ...(this.peerBinding && id.localAddress !== undefined ? { localAddress: id.localAddress } : {}),
+      }, (res) => {
+        const chunks: Buffer[] = [];
+        res.on('data', (d: Buffer) => chunks.push(d));
+        res.on('end', () => resolve({ status: res.statusCode ?? 0, rawHeaders: res.rawHeaders, body: Buffer.concat(chunks) }));
+        res.on('error', reject);
+      });
+      req.on('error', reject);
+      if (bytes.length > 0) req.end(Buffer.from(bytes));
+      else req.end();
+    });
+  }
+
+  override buildManifest(): Manifest {
+    const m = super.buildManifest();
+    const t = this.manifestText;
+    if (t === undefined) return m;
+    return { ...m, title: t.title, contests: t.contests, trustees: m.trustees.map((x, i) => ({ ...x, name: t.trusteeNames[i] ?? x.name })) };
+  }
+}
