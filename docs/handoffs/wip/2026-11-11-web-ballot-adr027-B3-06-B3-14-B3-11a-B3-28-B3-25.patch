@@ -0,0 +1,381 @@
+// QV-ADR-027 web items: B3-06 (PAUSED from signed control entries, gated on a fresh witnessed tree head), B3-14 (one-ballot
+// guarantee 4), B3-25 (shared passphrase canonicalization, canonical-then-legacy unlock), B3-28 (pre-derivation cost warning).
+// Negative cases are the point: unauthorised, mis-scoped or malformed pauses, stale/forged/unbound heads, cancelled unlocks.
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { test } from 'node:test';
+import { addCosignatures, cosignLine, parseCheckpoint, signCheckpoint } from '@quietvote/board';
+import { bytesToHex, ed25519Keypair, sha256, streamRng, utf8, type Ed25519Keypair } from '@quietvote/crypto';
+import { PROTO, signRecordRaw, type Manifest } from '@quietvote/protocol';
+import { ApiClient } from '../src/api/client.ts';
+import { deriveElectionContext, isOneBallot } from '../src/flow/election.ts';
+import { importKeyFile, recoveryCodeFor, unlockKey } from '../src/flow/onboarding.ts';
+import { COSIG_FUTURE_SEC, STH_FRESH_SEC, entryRecords, headIsFresh, pauseInEffect, readHeadNote, type LogRec } from '../src/flow/pause.ts';
+import { EN } from '../src/i18n/en.ts';
+import { GUARANTEE_KEYS, LOCALES, gate, offeredLocales } from '../src/i18n/locales.ts';
+import {
+  CEILING_PARAMS, DEFAULT_PARAMS, FLOOR_PARAMS, KeyError, defaultDeps, exceedsDefaultCost, parseContainer, serializeContainer, unwrapSeed, wrapSeed,
+  type KdfParams, type KeystoreDeps,
+} from '../src/key/keystore.ts';
+import { canonicalPassphrase, legacyExactPassphrase, unlockPassphraseForms } from '../src/key/passphrase.ts';
+import { MemoryStorage } from '../src/key/storage.ts';
+import { LiveElection, type LiveChange, type LiveTarget } from '../src/flow/live.ts';
+import type { FetchLike } from '../src/api/client.ts';
+import { FakeBoard, TEST_CONTESTS } from './helpers/fake-board.ts';
+import { FakeSseServer, entryEvent, until } from './helpers/fake-sse.ts';
+import { kp, setup, type Sim } from '../../protocol/test/helpers/sim.ts';
+
+// ---------------------------------------------------------------- B3-06
+
+const WNAME = 'witness.example/w1';
+const W = kp('adr027', 'witness');
+const NOW = 1_800_000_000;
+let simP: Promise<Sim> | undefined;
+/** A board-bound simulation whose manifest names one witness with quorum 1, so a head can be dated. */
+const witnessedSim = (): Promise<Sim> =>
+  (simP ??= setup({ seed: 'adr027-pause', n: 3, t: 2, voters: 4, contests: TEST_CONTESTS()!, minCounted: 3, witnesses: [{ name: WNAME, pk: bytesToHex(W.publicKey) }], witnessQuorum: 1 }));
+
+function control(sim: Sim, action: string, o: { signer?: Ed25519Keypair; scope?: Uint8Array; extra?: Record<string, unknown> } = {}): unknown {
+  const body = { proto: PROTO, type: 'control', action, ...o.extra };
+  const s = o.signer ?? sim.coord[0]!;
+  return { body, sigs: [signRecordRaw(s.secretKey, s.publicKey, o.scope ?? sim.mh, 'control', body)] };
+}
+
+async function read(board: FakeBoard): Promise<{ records: LogRec[]; note: string | undefined }> {
+  const api = new ApiClient({ fetch: board.fetch, sleep: async () => undefined });
+  const all = await api.allEntries(board.apiId);
+  return { records: entryRecords(all.entries), note: await readHeadNote(api, board.apiId) };
+}
+
+function cosigned(note: string, ts: number, w: Ed25519Keypair = W, name = WNAME): string {
+  const cp = parseCheckpoint(note);
+  assert.ok(cp.ok);
+  return addCosignatures(note, [cosignLine(name, w.secretKey, w.publicKey, cp.value.text, ts)]);
+}
+
+async function phaseOf(records: LogRec[], note: string | undefined): Promise<{ phase: string; pauseSeq: number | undefined; confirmed: boolean | undefined }> {
+  const r = await deriveElectionContext(records, undefined, undefined, { head: { note, nowSec: NOW } });
+  assert.ok(r.ok, r.ok ? '' : r.detail);
+  return { phase: r.value.phase, pauseSeq: r.value.pauseSeq, confirmed: r.value.pauseConfirmed };
+}
+
+test('B3-06: a coordinator pause is PAUSED only with a fresh witnessed head for exactly the entries read; never closed', async () => {
+  const sim = await witnessedSim();
+  const board = new FakeBoard(sim);
+  const before = await read(board);
+  assert.equal((await phaseOf(before.records, cosigned(before.note!, NOW - 5))).phase, 'open', 'no pause on record: a fresh head changes nothing');
+
+  const seq = board.appendControl(control(sim, 'pause', { extra: { reason: 'power cut at the hall' } }));
+  const { records, note } = await read(board);
+  assert.ok(note !== undefined);
+
+  // No head at all, or a head without cosignatures: the pause is on record but unconfirmed, so the phase stays open.
+  const noHead = await deriveElectionContext(records);
+  assert.ok(noHead.ok);
+  assert.equal(noHead.value.phase, 'open');
+  assert.equal(noHead.value.pauseSeq, seq);
+  assert.equal(noHead.value.pauseConfirmed, false);
+  assert.deepEqual(await phaseOf(records, note), { phase: 'open', pauseSeq: seq, confirmed: false });
+
+  // Fresh witnessed head: PAUSED.
+  assert.deepEqual(await phaseOf(records, cosigned(note, NOW - 10)), { phase: 'paused', pauseSeq: seq, confirmed: true });
+  assert.deepEqual(headIsFresh({ manifest: sim.manifest, records, note: cosigned(note, NOW + COSIG_FUTURE_SEC), nowSec: NOW }), { fresh: true });
+
+  const m = sim.manifest;
+  const verdict = (n: string | undefined, recs: readonly LogRec[] = records): boolean => headIsFresh({ manifest: m, records: recs, note: n, nowSec: NOW }).fresh;
+  assert.equal(verdict(undefined), false, 'no head');
+  assert.equal(verdict('not a checkpoint'), false, 'unparseable head');
+  assert.equal(verdict(cosigned(note, NOW - STH_FRESH_SEC - 1)), false, 'cosignature older than 60 s');
+  assert.equal(verdict(cosigned(note, NOW + COSIG_FUTURE_SEC + 1)), false, 'cosignature too far in the future');
+  assert.equal(verdict(cosigned(note, NOW - 1, kp('adr027', 'stranger'))), false, 'cosignature by a key the manifest does not name');
+  assert.equal(verdict(cosigned(note, NOW - 1, W, 'witness.example/other')), false, 'cosignature under a name the manifest does not list');
+  // A fresh head that predates the pause (the operator withholding it) does not cover the entries read.
+  assert.equal(verdict(cosigned(board.noteBySize.get(seq)!, NOW - 1)), false, 'head for an older tree size');
+  const cp = parseCheckpoint(note);
+  assert.ok(cp.ok);
+  const other = ed25519Keypair(streamRng('other-log').bytes(32));
+  assert.equal(verdict(cosigned(signCheckpoint(cp.value.origin, cp.value.size, new Uint8Array(32).fill(9), board.logKey.secretKey, board.logKey.publicKey), NOW - 1)), false, 'root differs from the entries read');
+  assert.equal(verdict(cosigned(signCheckpoint(cp.value.origin, cp.value.size, cp.value.root, other.secretKey, other.publicKey), NOW - 1)), false, 'head not signed by the manifest log key');
+  assert.equal(verdict(cosigned(signCheckpoint('example.org/other-log', cp.value.size, cp.value.root, board.logKey.secretKey, board.logKey.publicKey), NOW - 1)), false, 'head for another origin');
+  const unbound = records.map((r) => (r.seq === seq ? { ...r, leaf: undefined } : r));
+  assert.equal(verdict(cosigned(note, NOW - 1), unbound), false, 'an entry whose header does not bind its body');
+  assert.equal(verdict(cosigned(note, NOW - 1), records.slice(0, -1)), false, 'fewer entries than the head covers');
+
+  // A manifest without witnesses can never confirm a pause (nothing dates the head).
+  const plain: Manifest = { ...m, bb: { ...m.bb, witness_quorum: 0 } };
+  delete (plain.bb as { witnesses?: unknown }).witnesses;
+  assert.equal(headIsFresh({ manifest: plain, records, note: cosigned(note, NOW - 1), nowSec: NOW }).fresh, false);
+
+  // Every variant above stays open; none reports closed.
+  for (const n of [undefined, note, cosigned(note, NOW - 61), cosigned(note, NOW - 1)]) assert.notEqual((await phaseOf(records, n)).phase, 'closed');
+});
+
+test('B3-06: only an authorised, well-formed, manifest-scoped pause counts (QV-ADR-022: the operator never pauses)', async () => {
+  const sim = await witnessedSim();
+  const m = sim.manifest;
+  const tryPause = async (rec: unknown, manifest: Manifest = m): Promise<{ inEffect: number | undefined; phase: string }> => {
+    const board = new FakeBoard(sim);
+    board.appendControl(rec);
+    const { records, note } = await read(board);
+    const r = await deriveElectionContext(records, undefined, undefined, { head: { note: cosigned(note!, NOW - 1), nowSec: NOW } });
+    assert.ok(r.ok);
+    return { inEffect: pauseInEffect(records, manifest, sim.mh, r.value.openSeq!), phase: r.value.phase };
+  };
+  const stranger = kp('adr027', 'stranger');
+  assert.deepEqual(await tryPause(control(sim, 'pause', { signer: stranger })), { inEffect: undefined, phase: 'open' }, 'not a coordinator key');
+  assert.deepEqual(await tryPause(control(sim, 'pause', { scope: sim.params!.ctx })), { inEffect: undefined, phase: 'open' }, 'signed under ctx, not the manifest hash');
+  assert.deepEqual(await tryPause(control(sim, 'pause', { scope: sha256(utf8('another election')) })), { inEffect: undefined, phase: 'open' }, 'signed for another election');
+  assert.deepEqual(await tryPause(control(sim, 'pause', { extra: { quorum: 0 } })), { inEffect: undefined, phase: 'open' }, 'closed schema: unknown field');
+  assert.deepEqual(await tryPause(control(sim, 'halt')), { inEffect: undefined, phase: 'open' }, 'not a pause action');
+  const forged = control(sim, 'pause') as { body: Record<string, unknown>; sigs: unknown[] };
+  assert.deepEqual(await tryPause({ body: { ...forged.body, reason: 'edited after signing' }, sigs: forged.sigs }), { inEffect: undefined, phase: 'open' }, 'body changed after signing');
+  assert.deepEqual(await tryPause({ body: forged.body, sigs: [] }), { inEffect: undefined, phase: 'open' }, 'no signatures');
+
+  // The log (operator) key never counts, even when a manifest also lists it as a coordinator key.
+  const log: Ed25519Keypair = new FakeBoard(sim).logKey;
