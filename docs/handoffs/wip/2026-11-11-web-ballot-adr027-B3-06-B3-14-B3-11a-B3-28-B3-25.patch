+/** Fast deterministic stand-in for Argon2id that records every KEK input, so tests can count derivations. */
+function spyDeps(seed = 'spy'): KeystoreDeps & { inputs: string[] } {
+  const inputs: string[] = [];
+  return {
+    ...defaultDeps(),
+    rng: streamRng(seed),
+    inputs,
+    kdf: async (pw, salt, prm) => {
+      inputs.push(new TextDecoder().decode(pw));
+      const b = new Uint8Array(pw.length + salt.length + 8);
+      b.set(pw, 0);
+      b.set(salt, pw.length);
+      new DataView(b.buffer).setUint32(pw.length + salt.length, prm.m);
+      new DataView(b.buffer).setUint32(pw.length + salt.length + 4, prm.t);
+      return sha256(b);
+    },
+  };
+}
+
+const LEGACY_PHRASE = 'LOBE-kuga-guna-husa-tejo-nula-neno';
+/**
+ * Legacy fixture: written by the pre-ADR CLI (`qv keygen --seed-file <32 x 0x07> --passphrase-file <LEGACY_PHRASE>
+ * --kdf-memory-kib 19456 --kdf-iterations 2`, 2026-11-11), whose KEK input is NFKC(passphrase) only.
+ */
+const CLI_LEGACY = '{"aad":"qv-key-v1|fe812c12f3ab4ce6","aead":"A256GCM","ct":"d2342a9c9cd0e4173724668c769fa3a5ab98d83a6194049481e98533be6b8375edf760b61360e28eb1f1afb96cbe7e45aa9ac977e71d59a6bb0cfea1567fdf317f8bdc16394d978ab4cb452e25e346e4","iv":"92052abc0d3c5c5fb8e8bb3c","kdf":"argon2id","keyId":"fe812c12f3ab4ce6","m":19456,"p":1,"salt":"43a7c7398b1800510746ca5acf06bee8","t":2,"v":1}';
+const CLI_LEGACY_PK = 'ea4a6c63e29c520abef5507b132ec5f9954776aebebe7b92421eea691446d22c';
+
+test('B3-25: the shared canonical form, and the at most two forms unlock tries (canonical first, then legacy exact)', () => {
+  assert.equal(canonicalPassphrase(LEGACY_PHRASE), 'lobe kuga guna husa tejo nula neno');
+  assert.equal(canonicalPassphrase(' Lobe\tKUGA  guna-husa tejo nula neno\n'), 'lobe kuga guna husa tejo nula neno');
+  assert.equal(canonicalPassphrase('lobe kuga guna husa tejo'), 'lobe kuga guna husa tejo', 'five words: not a word passphrase, NFKC only');
+  assert.equal(canonicalPassphrase('LOBE kuga guna husa tejo'), 'LOBE kuga guna husa tejo', 'below six words nothing is folded');
+  assert.equal(canonicalPassphrase('ｆｕｌｌ width pass phrase'), 'full width pass phrase', 'free text: NFKC');
+  assert.equal(canonicalPassphrase('Lobe kuga guna husa tejo nula zzzz'), 'Lobe kuga guna husa tejo nula zzzz', 'one non-list word: NFKC only');
+  assert.equal(legacyExactPassphrase(LEGACY_PHRASE), LEGACY_PHRASE);
+  assert.deepEqual(unlockPassphraseForms(LEGACY_PHRASE), ['lobe kuga guna husa tejo nula neno', LEGACY_PHRASE]);
+  assert.deepEqual(unlockPassphraseForms('lobe kuga guna husa tejo nula neno'), ['lobe kuga guna husa tejo nula neno'], 'one form when they agree');
+  assert.deepEqual(unlockPassphraseForms('ｆｕｌｌ width pass phrase'), ['full width pass phrase']);
+});
