+test('B3-25: wrap always uses the canonical form; unlock runs the KDF at most twice and times only the run that worked', async () => {
+  const d = spyDeps();
+  const seed = streamRng('b325').bytes(32);
+  const { container } = await wrapSeed(seed, LEGACY_PHRASE, d, FLOOR_PARAMS);
+  assert.deepEqual(d.inputs, ['lobe kuga guna husa tejo nula neno'], 'wrap: canonical KEK input only');
+
+  // Canonical container: any spelling with the same canonical form unlocks on the first derivation.
+  for (const p of ['lobe kuga guna husa tejo nula neno', LEGACY_PHRASE, 'Lobe Kuga Guna Husa Tejo Nula Neno']) {
+    d.inputs.length = 0;
+    assert.deepEqual((await unwrapSeed(container, p, d)).seed, seed, p);
+    assert.equal(d.inputs.length, 1, p);
+  }
+  // Wrong passphrase: both forms tried, never more, and still E_KEY_LOCKED.
+  d.inputs.length = 0;
+  await assert.rejects(() => unwrapSeed(container, 'LOBE-kuga-guna-husa-tejo-nula-lobe', d), (e: unknown) => e instanceof KeyError && e.code === 'E_KEY_LOCKED');
+  assert.deepEqual(d.inputs, ['lobe kuga guna husa tejo nula lobe', 'LOBE-kuga-guna-husa-tejo-nula-lobe']);
+  d.inputs.length = 0;
+  await assert.rejects(() => unwrapSeed(container, 'a long wrong free-text phrase', d), (e: unknown) => e instanceof KeyError && e.code === 'E_KEY_LOCKED');
+  assert.equal(d.inputs.length, 1, 'free text has one form: one derivation');
+
+  // Legacy-form container (KEK input = exact phrase), built through the same deps: canonical tried first, legacy second.
+  const legacyDeps: KeystoreDeps = { ...d, kdf: (_pw, salt, prm, p) => d.kdf(utf8(LEGACY_PHRASE), salt, prm, p) };
+  const legacy = (await wrapSeed(seed, 'ignored by the legacy kdf', legacyDeps, FLOOR_PARAMS)).container;
+  d.inputs.length = 0;
+  let clock = 0;
+  const timed: KeystoreDeps = { ...d, kdf: async (pw, salt, prm, p) => { clock += 1000; return d.kdf(pw, salt, prm, p); } };
+  const u = await unwrapSeed(legacy, LEGACY_PHRASE, timed, undefined, () => clock);
+  assert.deepEqual(u.seed, seed);
+  assert.deepEqual(d.inputs, ['lobe kuga guna husa tejo nula neno', LEGACY_PHRASE]);
+  assert.equal(u.elapsedMs, 1000, 'calibration measures one derivation, not both');
+});
