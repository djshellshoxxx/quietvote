+  d.inputs.length = 0;
+  await assert.rejects(() => unwrapSeed(container, pass, d, undefined, undefined, { confirmCost: (p) => { asked.push(p); return false; } }), (e: unknown) => e instanceof KeyError && e.code === 'E_KEY_CANCELLED');
+  assert.deepEqual(asked, [costly]);
+  assert.equal(d.inputs.length, 0, 'cancel: no derivation ran');
+  await assert.rejects(() => unwrapSeed(container, pass, d, undefined, undefined, { confirmCost: async () => undefined as unknown as boolean }), (e: unknown) => e instanceof KeyError && e.code === 'E_KEY_CANCELLED', 'anything but true cancels');
+  assert.equal(d.inputs.length, 0);
+  // A wrong passphrase is only discovered after the user continued (the warning comes first).
+  await assert.rejects(() => unwrapSeed(container, 'not the passphrase at all', d, undefined, undefined, { confirmCost: () => true }), (e: unknown) => e instanceof KeyError && e.code === 'E_KEY_LOCKED');
