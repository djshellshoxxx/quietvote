new file mode 100644
index 0000000..0a92f90
--- /dev/null
+++ b/packages/web/src/flow/pause.ts
@@ -0,0 +1,113 @@
+// QV-ADR-027 B3-06 (option A, gated on STH freshness): the web client derives PAUSED from signed pause/resume control
+// entries in the log it has read, never from a server message, and shows PAUSED only when a fresh, witnessed tree head
+// proves that log prefix is the current one. A pause is never shown as "closed".
+//
+// Authority (QV-ADR-022, QV-07-REQ-082, protocol NOTES X-31): a pause/resume is a control record
+// `{proto, type: "control", action, reason?}` carrying >= coordinator.m valid coordinator record signatures over
+// sig-record(manifest_hash, "control", body), the steward authority the v1 manifest defines. The log (operator) key never
+// counts, even if a manifest also lists it as a coordinator: the operator may only hold or notify, never pause or resume.
+// The v1 manifest has no trustee pause delegation, so trustee-signed pauses are not accepted.
+//
+// Freshness (QV-07-REQ-041: a new tree head at least every 60 s while OPEN or PAUSED): the C2SP checkpoint carries no time
+// of its own; timestamps are advisory except where witnesses cosign them (QV-18 §2). PAUSED is therefore confirmed only by a
+// log-signed checkpoint (manifest log key and origin) whose size equals the number of entries read and whose root equals the
+// root recomputed from those entries, with >= max(1, witness_quorum) valid cosignatures from manifest witnesses dated within
+// the last 60 s (and not more than 300 s in the future, QV-18 §9.3). Without that (no witnesses, stale or unbound head) the
+// pause stays "unconfirmed": the ballot is not blocked, and the page only says a signed pause is on record.
+import { MerkleTree, bodyDigest, bytesEqual, decodeHeader, hashLeaf, parseCheckpoint, verifyLogSignature, witnessStatus } from '@quietvote/board';
+import { hexToBytes } from '@quietvote/crypto';
+import {
+  PROTO, S, check, lit, logOrigin, obj, str, verifyMultiSig, witnessAnchors, type Manifest, type MultiSignedRecord,
+} from '@quietvote/protocol';
+import type { EntryView } from '../api/types.ts';
+import { b64uDecode } from '../util/hex.ts';
+import { entryRecord } from './entries.ts';
+
+/** QV-07-REQ-041: tree-head cadence while OPEN or PAUSED, in seconds. */
+export const STH_FRESH_SEC = 60;
+/** QV-18 §9.3: cosignatures dated more than this far in the future are rejected online. */
+export const COSIG_FUTURE_SEC = 300;
+
+/** A log entry as the client keeps it. `leaf` is the RFC 9162 leaf hash the client computed from the entry's own header. */
+export interface LogRec {
+  seq: number;
+  record: unknown;
+  leaf?: Uint8Array | undefined;
+}
+
+/** Same closed schema as the protocol verifier's control record (logcheck.ts CONTROL_RECORD, QV-16 §4 rule 7). */
+const CONTROL_RECORD = S.multiSigned(obj({ proto: lit(PROTO), type: lit('control'), action: str(32) }, { reason: str(256) }));
+
+/**
+ * Decodes entries for the client: the parsed record plus the leaf hash, computed only when the header decodes and its body
+ * digest/length match the body bytes (redacted entries keep the header leaf; their record is undefined).
+ */
+export function entryRecords(entries: readonly EntryView[]): LogRec[] {
+  return entries.map((e) => {
+    const rec: LogRec = { seq: e.seq, record: entryRecord(e) };
+    const hb = b64uDecode(e.header_b64u);
+    const body = e.body_b64u === null ? null : b64uDecode(e.body_b64u);
+    if (hb !== undefined && body !== undefined) {
+      const d = decodeHeader(hb);
+      if (d.ok && (body === null || (body.length === d.value.bodyLen && bytesEqual(bodyDigest(body), d.value.bodyDigest)))) rec.leaf = hashLeaf(hb);
+    }
+    return rec;
+  });
+}
+
+/**
+ * Seq of the authorised pause in effect at the end of `records`, or undefined when voting is not paused there. Only entries
+ * strictly after election-open and before election-close count; a resume ends a pause; a pause while paused or a resume
+ * while running is ignored, like the server's state machine.
+ */
+export function pauseInEffect(records: readonly LogRec[], m: Manifest, mh: Uint8Array, openSeq: number, closeSeq?: number): number | undefined {
+  const keys = m.coordinator.keys.filter((k) => k.toLowerCase() !== m.bb.log_pk.toLowerCase());
+  let paused: number | undefined;
+  const sorted = [...records].sort((a, b) => a.seq - b.seq);
+  for (const { seq, record } of sorted) {
+    if (seq <= openSeq || (closeSeq !== undefined && seq >= closeSeq)) continue;
+    const b = (record as { body?: { type?: unknown } } | undefined)?.body;
+    if (b?.type !== 'control' || check(CONTROL_RECORD, record) !== null) continue;
+    const r = record as MultiSignedRecord<{ type: string; action: string }>;
+    if (r.body.action !== 'pause' && r.body.action !== 'resume') continue;
+    if (!verifyMultiSig(mh, r, keys, m.coordinator.m)) continue;
+    if (r.body.action === 'pause' && paused === undefined) paused = seq;
+    else if (r.body.action === 'resume' && paused !== undefined) paused = undefined;
+  }
+  return paused;
+}
+
+export type HeadVerdict = { fresh: true } | { fresh: false; reason: string };
+
+/**
+ * Is `note` a fresh, witnessed tree head for exactly the entries in `records`? See the module comment for the rule.
+ * `nowSec` is the client's clock (Unix seconds).
+ */
+export function headIsFresh(i: { manifest: Manifest; records: readonly LogRec[]; note: string | undefined; nowSec: number }): HeadVerdict {
+  const m = i.manifest;
+  if (i.note === undefined) return { fresh: false, reason: 'no tree head' };
+  const p = parseCheckpoint(i.note);
+  if (!p.ok) return { fresh: false, reason: 'tree head does not parse' };
+  const cp = p.value;
+  if (cp.origin !== logOrigin(m) || !verifyLogSignature(cp, hexToBytes(m.bb.log_pk, 32))) return { fresh: false, reason: 'tree head is not signed by the manifest log' };
+  const sorted = [...i.records].sort((a, b) => a.seq - b.seq);
+  if (cp.size !== sorted.length || sorted.some((r, k) => r.seq !== k || r.leaf === undefined)) return { fresh: false, reason: 'tree head does not cover exactly the entries read' };
+  if (!bytesEqual(MerkleTree.fromLeafHashes(sorted.map((r) => r.leaf!)).root(), cp.root)) return { fresh: false, reason: 'tree head root differs from the entries read' };
+  const { anchors } = witnessAnchors(m);
+  const quorum = Math.max(1, m.bb.witness_quorum);
+  if (anchors.length < quorum) return { fresh: false, reason: 'no manifest witnesses to date the tree head' };
+  const ws = witnessStatus(cp, { witnesses: anchors, quorum, noneAcknowledged: false }, i.nowSec + COSIG_FUTURE_SEC);
+  const recent = [...ws.valid.values()].filter((ts) => ts >= i.nowSec - STH_FRESH_SEC);
+  if (recent.length < quorum) return { fresh: false, reason: 'tree head is not witnessed within the last 60 s' };
+  return { fresh: true };
+}
+
+/** The log's current checkpoint note, or undefined when the server has none or the read fails (then no pause is confirmed). */
+export async function readHeadNote(api: { checkpointNote?: (id: string) => Promise<string> }, id: string): Promise<string | undefined> {
+  if (api.checkpointNote === undefined) return undefined;
+  try {
+    return await api.checkpointNote(id);
+  } catch {
+    return undefined;
+  }
+}
